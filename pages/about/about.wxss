/* about.wxss */
.container {
  padding: 0 30rpx;
  padding-bottom: 100rpx;
}

.about-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.app-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
  overflow: hidden;
  margin: 60rpx 0 30rpx;
  background: #f5f5f5;
}

.app-icon image {
  width: 100%;
  height: 100%;
}

.app-info {
  text-align: center;
  margin-bottom: 60rpx;
}

.app-name {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.app-version {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.section {
  width: 100%;
  margin-bottom: 50rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.section-content {
  font-size: 28rpx;
  color: #666;
  line-height: 44rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.contact-label {
  font-size: 28rpx;
  color: #666;
  width: 160rpx;
}

.contact-value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.copyright {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-top: 80rpx;
}