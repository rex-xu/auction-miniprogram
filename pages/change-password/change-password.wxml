<!-- change-password.wxml -->
<view class="container">
  <view class="header">
    <text class="title">修改密码</text>
  </view>
  
  <view class="form-container">
    <!-- 当前密码 -->
    <view class="form-item">
      <text class="label">当前密码</text>
      <view class="input-wrapper">
        <input 
          class="input" 
          type="password" 
          placeholder="请输入当前密码" 
          value="{{oldPassword}}"
          bindinput="onOldPasswordInput"
        />
        <view 
          class="clear-icon" 
          wx:if="{{oldPassword}}" 
          bindtap="clearInput" 
          data-type="old"
        >
          ✕
        </view>
      </view>
    </view>
    
    <!-- 新密码 -->
    <view class="form-item">
      <text class="label">新密码</text>
      <view class="input-wrapper">
        <input 
          class="input" 
          type="password" 
          placeholder="请输入6-20位新密码" 
          value="{{newPassword}}"
          bindinput="onNewPasswordInput"
        />
        <view 
          class="clear-icon" 
          wx:if="{{newPassword}}" 
          bindtap="clearInput" 
          data-type="new"
        >
          ✕
        </view>
      </view>
    </view>
    
    <!-- 确认新密码 -->
    <view class="form-item">
      <text class="label">确认新密码</text>
      <view class="input-wrapper">
        <input 
          class="input" 
          type="password" 
          placeholder="请再次输入新密码" 
          value="{{confirmPassword}}"
          bindinput="onConfirmPasswordInput"
        />
        <view 
          class="clear-icon" 
          wx:if="{{confirmPassword}}" 
          bindtap="clearInput" 
          data-type="confirm"
        >
          ✕
        </view>
      </view>
    </view>
    
    <!-- 密码强度提示 -->
    <view class="password-hint" wx:if="{{newPassword}}">
      <text class="hint-text">密码应包含字母和数字，建议8位以上</text>
    </view>
    
    <!-- 提交按钮 -->
    <button 
      class="submit-btn"
      type="primary"
      loading="{{loading}}"
      disabled="{{buttonDisabled}}"
      bindtap="changePassword"
    >
      确认修改
    </button>
  </view>
</view>