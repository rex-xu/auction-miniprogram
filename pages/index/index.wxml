<!-- index.wxml -->
<view class="container">
  <view class="header">
    <text class="title">热门拍卖</text>
    <text class="subtitle">发现优质拍品</text>
  </view>
  
  <!-- 筛选标签 -->
  <view class="filter-tags">
    <view class="tag {{activeTags.all}}" bindtap="switchTab" data-tab="all">全部</view>
    <view class="tag {{activeTags.ongoing}}" bindtap="switchTab" data-tab="ongoing">进行中</view>
    <view class="tag {{activeTags.upcoming}}" bindtap="switchTab" data-tab="upcoming">即将开始</view>
  </view>
  
  <!-- 拍卖项目列表 -->
  <view class="auction-list">
    <block wx:if="{{auctionItems.length > 0}}">
      <view wx:for="{{auctionItems}}" wx:key="id" class="card" bindtap="navigateToDetail" data-id="{{item.id}}">
        <view class="auction-item">
          <view class="auction-image">
            <image src="{{item.display_image_url}}" mode="aspectFill"></image>
          </view>
          <view class="auction-info">
            <view class="auction-title">{{item.title}}</view>
            <view class="auction-meta">
              <text class="current-price"><text class="price-symbol">¥</text>{{item.current_price}}</text>
              <text class="bid-count">{{item.bid_count}}次出价</text>
            </view>
            <view class="auction-status">
              <text class="tag {{item.status_class}}">{{item.status_text}}</text>
              <view class="countdown" wx:if="{{item.show_ongoing_countdown}}">
                剩余: 
                <text class="countdown-item">{{item.formatted_hours}}</text>:
                <text class="countdown-item">{{item.formatted_minutes}}</text>:
                <text class="countdown-item">{{item.formatted_seconds}}</text>
              </view>
              <view class="countdown" wx:elif="{{item.show_upcoming_countdown}}">
                即将开始: 
                <text class="countdown-item">{{item.formatted_hours}}</text>:
                <text class="countdown-item">{{item.formatted_minutes}}</text>:
                <text class="countdown-item">{{item.formatted_seconds}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>
    <view wx:else class="empty-state">
      <image class="empty-icon" src="/assets/images/empty.png"></image>
      <text class="empty-text">暂无拍卖项目</text>
    </view>
  </view>
  
  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{hasMore}}" bindtap="loadMore">
    <text>上拉加载更多</text>
  </view>
</view>