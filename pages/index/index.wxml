<!-- index.wxml -->
<view class="container">
  <view class="header">
    <text class="title">热门拍卖</text>
    <text class="subtitle">发现优质拍品</text>
  </view>
  
  <!-- 筛选标签 -->
  <view class="filter-tags">
    <view class="tag {{activeTab === 'all' ? 'tag-active' : ''}}" bindtap="switchTab" data-tab="all">全部</view>
    <view class="tag {{activeTab === 'ongoing' ? 'tag-active' : ''}}" bindtap="switchTab" data-tab="ongoing">进行中</view>
    <view class="tag {{activeTab === 'upcoming' ? 'tag-active' : ''}}" bindtap="switchTab" data-tab="upcoming">即将开始</view>
  </view>
  
  <!-- 拍卖项目列表 -->
  <view class="auction-list">
    <block wx:if="auctionItems.length > 0">
      <view wx:for="{{auctionItems}}" wx:key="id" class="card" bindtap="navigateToDetail" data-id="{{item.id}}">
        <view class="auction-item">
          <view class="auction-image">
            <image src="{{item.image_url || '/assets/images/default-item.png'}}" mode="aspectFill"></image>
          </view>
          <view class="auction-info">
            <view class="auction-title">{{item.title}}</view>
            <view class="auction-meta">
              <text class="current-price"><text class="price-symbol">¥</text>{{item.current_price}}</text>
              <text class="bid-count">{{item.bid_count}}次出价</text>
            </view>
            <view class="auction-status">
              <text class="tag {{getStatusClass(item.status)}}">{{getStatusText(item.status)}}</text>
              <view class="countdown" wx:if="item.status === 'in_progress'">
                剩余: 
                <text class="countdown-item">{{formatTime(item.remaining_time, 'hours')}}</text>:
                <text class="countdown-item">{{formatTime(item.remaining_time, 'minutes')}}</text>:
                <text class="countdown-item">{{formatTime(item.remaining_time, 'seconds')}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>
    <view wx:else class="empty-state">
      <image class="empty-icon" src="/assets/images/empty.png"></image>
      <text class="empty-text">暂无拍卖项目</text>
    </view>
  </view>
  
  <!-- 加载更多 -->
  <view class="load-more" wx:if="hasMore" bindtap="loadMore">
    <text>上拉加载更多</text>
  </view>
</view>