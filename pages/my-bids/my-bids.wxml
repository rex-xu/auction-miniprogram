<!-- my-bids.wxml -->
<view class="container">
  <view class="header">
    <text class="title">我的竞拍</text>
  </view>
  
  <!-- 未登录状态 -->
  <view class="login-prompt" wx:if="{{!isLoggedIn}}">
    <image class="login-icon" src="/assets/images/login.png"></image>
    <text class="login-text">请先登录后查看您的竞拍记录</text>
    <button class="btn-login" bindtap="goToLogin" type="primary">去登录</button>
  </view>
  
  <!-- 已登录状态 -->
  <view wx:elif="{{isLoggedIn}}">
    <!-- 筛选标签 -->
    <view class="filter-tags">
      <view class="tag {{activeTags.all}}" bindtap="switchTab" data-tab="all">全部</view>
      <view class="tag {{activeTags.ongoing}}" bindtap="switchTab" data-tab="ongoing">进行中</view>
      <view class="tag {{activeTags.won}}" bindtap="switchTab" data-tab="won">已中标</view>
      <view class="tag {{activeTags.lost}}" bindtap="switchTab" data-tab="lost">未中标</view>
    </view>
    
    <!-- 竞拍记录列表 -->
    <view class="bids-list">
      <block wx:if="{{bids.length > 0}}">
        <view wx:for="{{bids}}" wx:key="id" class="card" bindtap="navigateToDetail" data-id="{{item.auction_item.id}}">
          <view class="bid-item">
            <view class="bid-image">
              <image src="{{item.auction_item.display_image_url}}" mode="aspectFill"></image>
            </view>
            <view class="bid-info">
              <view class="bid-title">{{item.auction_item.title}}</view>
              <view class="bid-meta">
                <text class="bid-price"><text class="price-symbol">我的出价:¥</text>{{item.price}}</text>
                <text wx:if="{{item.is_not_highest}}" class="current-highest">
                  当前最高价:¥{{item.auction_item.current_price}}
                </text>
                <text wx:else class="i-am-highest">
                  ✓ 我是最高价
                </text>
              </view>
              <view class="bid-status">
                <text class="tag {{item.bid_status_class}}">{{item.bid_status_text}}</text>
              </view>
            </view>
          </view>
        </view>
      </block>
      <view class="empty-state" wx:else>
        <image class="empty-icon" src="/assets/images/empty.png"></image>
        <text class="empty-text">暂无竞拍记录</text>
      </view>
    </view>
    
    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{hasMore}}" bindtap="loadMore">
      <text>上拉加载更多</text>
    </view>
  </view>
</view>