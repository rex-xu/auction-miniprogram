<!-- my-bids.wxml -->
<view class="container">
  <view class="header">
    <text class="title">我的竞拍</text>
  </view>
  
  <!-- 筛选标签 -->
  <view class="filter-tags">
    <view class="tag {{activeTab === 'all' ? 'tag-active' : ''}}" bindtap="switchTab" data-tab="all">全部</view>
    <view class="tag {{activeTab === 'ongoing' ? 'tag-active' : ''}}" bindtap="switchTab" data-tab="ongoing">进行中</view>
    <view class="tag {{activeTab === 'won' ? 'tag-active' : ''}}" bindtap="switchTab" data-tab="won">已中标</view>
    <view class="tag {{activeTab === 'lost' ? 'tag-active' : ''}}" bindtap="switchTab" data-tab="lost">未中标</view>
  </view>
  
  <!-- 竞拍记录列表 -->
  <view class="bids-list">
    <block wx:if="bids.length > 0">
      <view wx:for="{{bids}}" wx:key="id" class="card" bindtap="navigateToDetail" data-id="{{item.auction_item.id}}">
        <view class="bid-item">
          <view class="bid-image">
            <image src="{{item.auction_item.image_url || '/assets/images/default-item.png'}}" mode="aspectFill"></image>
          </view>
          <view class="bid-info">
            <view class="bid-title">{{item.auction_item.title}}</view>
            <view class="bid-meta">
              <text class="bid-price"><text class="price-symbol">我的出价:¥</text>{{item.price}}</text>
              <text wx:if="item.auction_item.current_price > item.price" class="current-highest">
                当前最高价:¥{{item.auction_item.current_price}}
              </text>
              <text wx:else class="i-am-highest">
                ✓ 我是最高价
              </text>
            </view>
            <view class="bid-status">
              <text class="tag {{getBidStatusClass(item.auction_item.status, item.price, item.auction_item.current_price)}}">{{getBidStatusText(item.auction_item.status, item.price, item.auction_item.current_price)}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>
    <view wx:else class="empty-state">
      <image class="empty-icon" src="/assets/images/empty.png"></image>
      <text class="empty-text">暂无竞拍记录</text>
    </view>
  </view>
  
  <!-- 加载更多 -->
  <view class="load-more" wx:if="hasMore" bindtap="loadMore">
    <text>上拉加载更多</text>
  </view>
</view>