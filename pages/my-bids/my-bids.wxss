/* my-bids.wxss */
.header {
  margin-bottom: 30rpx;
}

.filter-tags {
  display: flex;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
  flex-wrap: wrap;
}

.filter-tags .tag {
  margin-right: 20rpx;
  margin-bottom: 16rpx;
}

.bids-list {
  padding-bottom: 100rpx;
}

.bid-item {
  display: flex;
  width: 100%;
}

.bid-image {
  width: 200rpx;
  height: 200rpx;
  margin-right: 20rpx;
  overflow: hidden;
  border-radius: 12rpx;
}

.bid-image image {
  width: 100%;
  height: 100%;
}

.bid-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.bid-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 16rpx;
  line-height: 40rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.bid-meta {
  display: flex;
  flex-direction: column;
  margin-bottom: 12rpx;
}

.bid-price {
  color: #333;
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.current-highest {
  font-size: 26rpx;
  color: #ff4d4f;
}

.i-am-highest {
  font-size: 26rpx;
  color: #52c41a;
}

.tag-success {
  background-color: #f6ffed;
  color: #52c41a;
  border: 1rpx solid #b7eb8f;
}

.tag-default {
  background-color: #f5f5f5;
  color: #999;
  border: 1rpx solid #d9d9d9;
}

.status-won {
  background-color: #f6ffed;
  color: #52c41a;
  border: 1rpx solid #b7eb8f;
}

.status-ongoing {
  background-color: #fffbe6;
  color: #faad14;
  border: 1rpx solid #ffe58f;
}

.status-lost {
  background-color: #fff1f0;
  color: #ff4d4f;
  border: 1rpx solid #ffccc7;
}

/* 未登录状态样式 */
.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  background-color: #f9f9f9;
  border-radius: 16rpx;
  margin: 40rpx;
}

.login-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 40rpx;
}

.login-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 40rpx;
  text-align: center;
  line-height: 44rpx;
}

.btn-login {
  width: 280rpx;
  font-size: 28rpx;
  background-color: #ff5555;
  color: #fff;
  border-radius: 60rpx;
}