/* logistics.wxss */

.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  background-color: #fff;
  padding: 30rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.loading-container {
  background-color: #fff;
  padding: 60rpx;
  text-align: center;
  border-radius: 10rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  margin: 0 auto 20rpx;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid #ff4d4f;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

.no-data-container {
  background-color: #fff;
  padding: 60rpx;
  text-align: center;
  border-radius: 10rpx;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto 20rpx;
  opacity: 0.5;
}

.no-data-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
  display: block;
}

.reload-btn {
  background-color: #fff;
  color: #ff4d4f;
  border: 2rpx solid #ff4d4f;
}

.logistics-content {
  background-color: #fff;
  border-radius: 10rpx;
  overflow: hidden;
}

.company-info {
  padding: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.company-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.tracking-no {
  font-size: 28rpx;
  color: #666;
}

.logistics-status {
  padding: 30rpx;
  background-color: #fff7f7;
  border-bottom: 2rpx solid #f0f0f0;
}

.status-text {
  font-size: 30rpx;
  color: #ff4d4f;
}

.logistics-timeline {
  padding: 30rpx;
  padding-left: 50rpx;
  position: relative;
}

.timeline-item {
  position: relative;
  padding-bottom: 40rpx;
}

.timeline-line {
  position: absolute;
  top: 20rpx;
  bottom: 0;
  left: -34rpx;
  width: 2rpx;
  background-color: #e0e0e0;
}

.timeline-item:last-child .timeline-line {
  display: none;
}

.timeline-dot {
  position: absolute;
  left: -48rpx;
  top: 8rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background-color: #e0e0e0;
  z-index: 1;
}

.timeline-dot.active {
  background-color: #ff4d4f;
}

.timeline-content {
  padding-left: 20rpx;
}

.timeline-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  display: block;
  margin-bottom: 10rpx;
}

.timeline-item:first-child .timeline-text {
  color: #ff4d4f;
  font-weight: 500;
}

.timeline-time {
  font-size: 24rpx;
  color: #999;
  display: block;
}

.timeline-location {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.action-buttons {
  padding: 30rpx;
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 28rpx;
  border-radius: 45rpx;
}

.action-btn:first-child {
  background-color: #ff4d4f;
  color: #fff;
}

.action-btn:first-child:active {
  background-color: #ff7875;
}

.action-btn:last-child {
  background-color: #fff;
  color: #666;
  border: 2rpx solid #ddd;
}

.action-btn:last-child:active {
  background-color: #f5f5f5;
}