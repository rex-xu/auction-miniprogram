/* login.wxss */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 40rpx;
  background-color: #f7f7f7;
}

.login-form {
  width: 100%;
  max-width: 400rpx;
  text-align: center;
}

.logo {
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto 60rpx;
}

.logo image {
  width: 100%;
  height: 100%;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 80rpx;
}

.wechat-login-section {
  width: 100%;
  margin-bottom: 60rpx;
}

.wechat-login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  background-color: #07C160;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  line-height: 96rpx;
  border: none;
}

.wechat-login-btn-hover {
  background-color: #06B055;
}

.wechat-icon {
  width: 50rpx;
  height: 50rpx;
  margin-right: 16rpx;
}

.login-note {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.login-agreement {
  font-size: 24rpx;
  color: #999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.agreement-link {
  color: #00662c;
}

/* 加载状态 */
.wechat-login-btn[loading="true"] {
  background-color: #CCCCCC;
}