<!-- login.wxml -->
<view class="container">
  <view class="login-form">
    <view class="logo">
      <image src="/assets/images/logo.png" mode="aspectFit"></image>
    </view>
    
    <text class="title">欢迎登录拍卖小程序</text>
    
    <view class="wechat-login-section">
      <button class="wechat-login-btn" open-type="getUserInfo" bindtap="wechatLogin" loading="{{loading}}" hover-class="wechat-login-btn-hover">
        <image class="wechat-icon" src="/assets/images/wechat.png"></image>
        <text class="wechat-text">微信一键登录</text>
      </button>
    </view>
    
    <view class="login-note">
      <text>登录即表示您同意我们的</text>
    </view>
    
    <view class="login-agreement">
      <text class="agreement-link" bindtap="viewAgreement">《用户协议》</text>
      <text>和</text>
      <text class="agreement-link" bindtap="viewPrivacy">《隐私政策》</text>
    </view>
  </view>
</view>