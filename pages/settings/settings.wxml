<!-- settings.wxml -->
<view class="container">
  <view class="header">
    <text class="title">设置</text>
  </view>
  
  <!-- 账户与安全 -->
  <view class="section">
    <view class="section-title">账户与安全</view>
    <view class="setting-item" bindtap="navigateToAccount">
      <text class="setting-label">账号管理</text>
      <image class="setting-arrow" src="/assets/icons/arrow-right.png"></image>
    </view>
    <view class="setting-item" bindtap="navigateToPrivacy">
      <text class="setting-label">隐私设置</text>
      <image class="setting-arrow" src="/assets/icons/arrow-right.png"></image>
    </view>
  </view>
  
  <!-- 通知设置 -->
  <view class="section">
    <view class="section-title">通知设置</view>
    <view class="setting-item">
      <text class="setting-label">竞拍提醒</text>
      <switch checked="{{notificationBid}}" bindchange="toggleNotificationBid" color="#00662c"></switch>
    </view>
    <view class="setting-item">
      <text class="setting-label">价格变动</text>
      <switch checked="{{notificationPrice}}" bindchange="toggleNotificationPrice" color="#00662c"></switch>
    </view>
    <view class="setting-item">
      <text class="setting-label">竞拍结束</text>
      <switch checked="{{notificationEnd}}" bindchange="toggleNotificationEnd" color="#00662c"></switch>
    </view>
  </view>
  
  <!-- 通用设置 -->
  <view class="section">
    <view class="section-title">通用设置</view>
    <view class="setting-item">
      <text class="setting-label">清除缓存</text>
      <text class="setting-value">{{cacheSize}}MB</text>
    </view>
    <view class="setting-item" bindtap="navigateToAbout">
      <text class="setting-label">关于我们</text>
      <text class="setting-value">v1.0.0</text>
    </view>
  </view>
  
  <!-- 退出登录按钮 -->
  <view class="logout-section">
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>
</view>