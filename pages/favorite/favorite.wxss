/* favorite.wxss */
.container {
  padding: 30rpx 30rpx 100rpx;
  background-color: #f7f7f7;
  min-height: 100vh;
}

.header {
  margin-bottom: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

/* 筛选标签 */
.filter-tags {
  display: flex;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 16rpx;
}

.tag {
  flex: 1;
  text-align: center;
  padding: 12rpx 20rpx;
  margin: 0 8rpx;
  font-size: 28rpx;
  color: #666;
  border-radius: 30rpx;
  transition: all 0.3s;
}

.tag.active {
  background-color: #00662c;
  color: #fff;
}

/* 收藏列表 */
.favorite-list {
  margin-bottom: 24rpx;
}

.favorite-item {
  position: relative;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

/* 拍卖商品样式 */
.auction-item {
  display: flex;
}

.item-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.item-image image {
  width: 100%;
  height: 100%;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  line-height: 40rpx;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 32rpx;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-meta {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.current-price {
  font-size: 28rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.bid-count {
  font-size: 24rpx;
  color: #999;
}

.item-status {
  display: flex;
  justify-content: flex-end;
}

.status-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  background-color: #f5f5f5;
  color: #666;
}

/* 藏品资讯样式 */
.article-item {
  display: flex;
}

.article-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.article-image image {
  width: 100%;
  height: 100%;
}

.article-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.article-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  line-height: 40rpx;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.article-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.article-category {
  font-size: 22rpx;
  color: #999;
}

.article-time {
  font-size: 22rpx;
  color: #999;
}

/* 取消收藏按钮 */
.unfavorite-btn {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  background-color: rgba(255, 255, 255, 0.8);
  border-radius: 20rpx;
  border: 1rpx solid #e0e0e0;
}

.unfavorite-btn .icon {
  font-size: 24rpx;
  color: #ff4d4f;
  margin-right: 8rpx;
}

.unfavorite-btn .text {
  font-size: 22rpx;
  color: #666;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 0;
}

.empty-image {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
}

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 60rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx 0;
}

.load-more-text {
  font-size: 28rpx;
  color: #666;
}

.load-more-text:active {
  color: #00662c;
}

/* 未登录状态样式 */
.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  background-color: #f9f9f9;
  border-radius: 16rpx;
  margin: 40rpx 0;
}

.login-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 40rpx;
}

.login-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 40rpx;
  text-align: center;
  line-height: 44rpx;
}

.btn-login {
  width: 280rpx;
  font-size: 28rpx;
  background-color: #00662c;
  color: #fff;
  border-radius: 60rpx;
}