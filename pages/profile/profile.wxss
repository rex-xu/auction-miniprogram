/* profile.wxss */
.user-card {
  display: flex;
  align-items: center;
  padding: 40rpx 20rpx;
  margin-bottom: 30rpx;
  background-color: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.user-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 30rpx;
  background-color: #f5f5f5;
}

.user-avatar image {
  width: 100%;
  height: 100%;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
  display: block;
}

.user-phone {
  font-size: 28rpx;
  color: #999;
}

.login-btn {
  margin-left: 20rpx;
}

.feature-list {
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
}

.feature-item {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.feature-item:last-child {
  border-bottom: none;
}

.feature-icon {
  font-size: 40rpx;
  margin-right: 30rpx;
}

.feature-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.feature-arrow {
  font-size: 24rpx;
  color: #999;
}

.logout-btn {
  margin-top: 40rpx;
  background-color: #fff;
  border: 1rpx solid #ff4d4f;
  color: #ff4d4f;
  font-size: 28rpx;
  height: 88rpx;
  line-height: 88rpx;
}