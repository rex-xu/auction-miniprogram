<!-- my-deposits.wxml -->
<view class="container">
  <view class="header">
    <text class="title">我的保证金</text>
  </view>
  
  <!-- 筛选标签 -->
  <view class="filter-tags">
    <view class="tag {{activeTab === 'all' ? 'tag-active' : ''}}" bindtap="switchTab" data-tab="all">全部</view>
    <view class="tag {{activeTab === 'paid' ? 'tag-active' : ''}}" bindtap="switchTab" data-tab="paid">已缴纳</view>
    <view class="tag {{activeTab === 'refunded' ? 'tag-active' : ''}}" bindtap="switchTab" data-tab="refunded">已退还</view>
  </view>
  
  <!-- 保证金记录列表 -->
  <view class="deposits-list">
    <block wx:if="{{deposits.length > 0}}">
      <view wx:for="{{deposits}}" wx:key="id" class="card" bindtap="goToAuctionDetail" data-id="{{item.auction_item_info.id}}">
        <view class="deposit-item">
          <view class="deposit-image">
            <image src="{{item.imageUrl}}" mode="aspectFill"></image>
          </view>
          <view class="deposit-info">
            <view class="deposit-title">{{item.auction_item_info.title}}</view>
            <view class="deposit-meta">
              <text class="deposit-amount"><text class="price-symbol">¥</text>{{item.amount}}</text>
              <text class="deposit-status">{{item.status_text}}</text>
            </view>
            <!-- 申请退款按钮，仅在状态为已缴纳且拍卖已结束时显示 -->
            <view class="deposit-actions" wx:if="{{item.status === 'paid' && item.auction_item_info.status !== 'in_progress' && (item.auction_item_info.winner_id !== userInfo.id || item.auction_item_info.status !== 'successful')}}">
              <button class="refund-btn" size="mini" catchtap="applyRefund" data-id="{{item.auction_item_info.id}}">申请退款</button>
            </view>
            <view class="deposit-time">
              <text>缴纳时间：{{item.formatted_created_at}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>
    <view wx:else class="empty-state">
      <image class="empty-icon" src="/assets/images/empty.png"></image>
      <text class="empty-text">暂无保证金记录</text>
    </view>
  </view>
  
  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{hasMore}}" bindtap="loadMore">
    <text>上拉加载更多</text>
  </view>
</view>