/* transaction-detail.wxss */
.container {
  padding: 30rpx 30rpx 200rpx;
  background-color: #f7f7f7;
  min-height: 100vh;
}

.header {
  margin-bottom: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

/* 状态区域 */
.status-section {
  padding: 40rpx;
  text-align: center;
  margin-bottom: 30rpx;
  border-radius: 16rpx;
  background-color: #fff;
}

.status-section.paid {
  background-color: #f6ffed;
  border: 1rpx solid #b7eb8f;
}

.status-section.unpaid {
  background-color: #fff7e6;
  border: 1rpx solid #ffd591;
}

.status-section.refunded {
  background-color: #f6f6ff;
  border: 1rpx solid #adc6ff;
}

.status-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.status-section.paid .status-icon {
  color: #52c41a;
}

.status-section.unpaid .status-icon {
  color: #fa8c16;
}

.status-section.refunded .status-icon {
  color: #1890ff;
}

.status-text {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.status-section.paid .status-text {
  color: #389e0d;
}

.status-section.unpaid .status-text {
  color: #d46b08;
}

.status-section.refunded .status-text {
  color: #096dd9;
}

.status-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 36rpx;
}

/* 区块样式 */
.section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

/* 拍卖品信息 */
.auction-item {
  display: flex;
}

.auction-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.auction-image image {
  width: 100%;
  height: 100%;
}

.auction-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.auction-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  line-height: 40rpx;
  margin-bottom: 8rpx;
}

.auction-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 32rpx;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.auction-meta {
  font-size: 22rpx;
  color: #999;
}

/* 信息项 */
.info-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #666;
  min-width: 140rpx;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.info-value.price {
  color: #ff4d4f;
  font-weight: bold;
}

/* 底部操作按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx 30rpx;
  background-color: #fff;
  border-top: 1rpx solid #f0f0f0;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.btn-primary {
  flex: 1;
  background-color: #00662c;
  color: #fff;
  border-radius: 60rpx;
  font-size: 30rpx;
  line-height: 80rpx;
  margin-left: 20rpx;
  border: none;
}

.btn-secondary {
  flex: 1;
  background-color: #f5f5f5;
  color: #666;
  border-radius: 60rpx;
  font-size: 30rpx;
  line-height: 80rpx;
  border: none;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-secondary:active {
  opacity: 0.8;
}