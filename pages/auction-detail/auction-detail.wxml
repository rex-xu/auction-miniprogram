<!-- auction-detail.wxml -->
<view class="container">
  <!-- 拍卖品轮播图 -->
  <view class="swiper-container">
    <swiper 
      indicator-dots="true" 
      autoplay="false" 
      interval="5000" 
      duration="500" 
      circular="true" 
      class="item-swiper"
      bindchange="onSwiperChange">
      <block wx:for="{{auctionItem.imageUrls}}" wx:key="index">
        <swiper-item>
          <image src="{{item}}" mode="aspectFill" class="swiper-image"></image>
        </swiper-item>
      </block>
    </swiper>
    <view class="image-count" wx:if="{{auctionItem.imageUrls.length > 1}}">
      {{currentSwiperIndex + 1}}/{{auctionItem.imageUrls.length}}
    </view>
  </view>
  
  <!-- 拍卖品信息 -->
  <view class="card">
    <view class="item-title">{{auctionItem.title}}</view>
    <view class="item-meta">
      <text class="current-price"><text class="price-symbol">当前价:¥</text>{{auctionItem.current_price}}</text>
      <text class="bid-increment">加价幅度: ¥{{auctionItem.bid_increment}}</text>
    </view>
    
    <!-- 状态和倒计时 -->
    <view class="item-status">
      <text class="tag {{auctionItem.status_class}}">{{auctionItem.status_text}}</text>
      <view class="countdown" wx:if="{{auctionItem.show_ongoing_countdown}}">
        距离结束: 
        <text class="countdown-item">{{auctionItem.formatted_hours}}</text>:
        <text class="countdown-item">{{auctionItem.formatted_minutes}}</text>:
        <text class="countdown-item">{{auctionItem.formatted_seconds}}</text>
      </view>
      <view class="countdown" wx:elif="{{auctionItem.show_upcoming_countdown}}">
        距离开始: 
        <text class="countdown-item">{{auctionItem.formatted_hours}}</text>:
        <text class="countdown-item">{{auctionItem.formatted_minutes}}</text>:
        <text class="countdown-item">{{auctionItem.formatted_seconds}}</text>
      </view>
      <text wx:else class="time-info">{{auctionItem.formatted_start_time ? '开始时间: ' + auctionItem.formatted_start_time : ''}}</text>
    </view>
    
    <!-- 保证金信息 -->
    <view class="deposit-info">
      <text class="deposit-text">保证金: ¥{{auctionItem.deposit_amount}}</text>
      <text class="deposit-status" wx:if="{{hasPaidDeposit}}">✓ 已缴纳</text>
      <text class="deposit-status" wx:else>✗ 未缴纳</text>
    </view>
  </view>
  
  <!-- 竞拍区域 -->
  <view class="card" wx:if="{{auctionItem.status === 'in_progress'}}">
    <text class="subtitle">当前出价</text>
    <input class="bid-input" type="number" placeholder="请输入出价金额" bindinput="onBidInput" value="{{bidPrice}}" />
    <view class="quick-bids">
      <text class="quick-bid" wx:for="{{quickBidOptions}}" wx:key="index" bindtap="onQuickBid" data-price="{{item}}">{{item}}</text>
    </view>
    <button class="btn btn-primary" bindtap="submitBid" 
            disabled="{{!canBid || !hasPaidDeposit}}" 
            loading="{{submittingBid}}">
      {{buttonText}}
    </button>
    <view wx:if="{{!hasPaidDeposit}}" class="deposit-tip">
      <text>您需要先缴纳保证金才能参与竞拍</text>
      <button class="btn btn-default" bindtap="navigateToDeposit" size="mini">去缴纳</button>
    </view>
  </view>
  
  <!-- 历史出价记录 -->
  <view class="card">
    <text class="subtitle">出价记录</text>
    <view class="bid-history">
      <block wx:if="{{bidHistory.length > 0}}">
        <view wx:for="{{bidHistory}}" wx:key="id" class="bid-record">
          <view class="bid-info">
            <text class="bidder">{{item.display_bidder_name}}</text>
            <text class="bid-price"><text class="price-symbol">¥</text>{{item.price}}</text>
          </view>
          <text class="bid-time">{{item.formatted_created_at}}</text>
        </view>
      </block>
      <view wx:else class="empty-state">
        <text class="empty-text">暂无出价记录</text>
      </view>
    </view>
  </view>
  
  <!-- 拍卖品详情 -->
  <view class="card">
    <text class="subtitle">商品详情</text>
    <rich-text class="item-description" nodes="{{auctionItem.display_description}}"/>
  </view>
</view>