/* auction-detail.wxss */
/* 轮播图样式 */
.swiper-container {
  width: 100%;
  height: 500rpx;
  position: relative;
  margin-bottom: 20rpx;
}

.item-swiper {
  width: 100%;
  height: 100%;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

/* 图片计数器样式 */
.image-count {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: white;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

/* 未登录提示样式 */
.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
  background-color: #f5f5f5;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.login-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}

.login-text {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.item-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  line-height: 50rpx;
}

.item-meta {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
}

.current-price {
  color: #ff4d4f;
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.bid-increment {
  font-size: 28rpx;
  color: #666;
}

.item-status {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.time-info {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #666;
}

.deposit-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.deposit-status {
  font-size: 26rpx;
}

.deposit-status:nth-of-type(2) {
  color: #52c41a;
}

.deposit-status:nth-of-type(3) {
  color: #ff4d4f;
}

.bid-input {
  height: 96rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 10rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.quick-bids {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 30rpx;
}

.quick-bid {
  display: inline-block;
  padding: 16rpx 32rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  background-color: #f5f5f5;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #333;
}

.deposit-tip {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding: 16rpx;
  background-color: #fff2f0;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #ff4d4f;
}

.deposit-tip button {
  font-size: 24rpx;
  line-height: 1.5;
  padding: 0 24rpx;
}

.bid-history {
  max-height: 500rpx;
  overflow-y: auto;
}

.bid-record {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.bid-record:last-child {
  border-bottom: none;
}

.bid-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.bidder {
  font-size: 28rpx;
  color: #333;
}

.bid-price {
  font-size: 30rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.bid-time {
  font-size: 24rpx;
  color: #999;
}

.item-description {
  font-size: 28rpx;
  line-height: 1.8;
  color: #333;
}

.item-description :first-child {
  margin-top: 0;
}

/* 收藏功能样式 */
.favorite-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
}

.favorite-count {
  font-size: 28rpx;
  color: #666;
}

.favorite-btn {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 40rpx;
  background-color: #fff;
  transition: all 0.3s;
}

.favorite-btn:active {
  opacity: 0.8;
}

.favorite-icon {
  font-size: 32rpx;
  color: #999;
  margin-right: 8rpx;
  transition: color 0.3s;
}

.favorite-icon.active {
  color: #ffd700;
}

.favorite-text {
  font-size: 28rpx;
  color: #666;
}