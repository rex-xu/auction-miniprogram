<!-- account.wxml -->
<view class="container">
  <view class="header">
    <text class="title">账号管理</text>
  </view>
  
  <view class="account-content">
    <!-- 用户基本信息 -->
    <view class="section">
      <view class="section-title">基本信息</view>
      <view class="info-item">
        <text class="info-label">头像</text>
        <view class="avatar-container">
          <image class="avatar" src="{{userInfo.avatar || '/assets/images/default-avatar.png'}}"></image>
        </view>
      </view>
      <view class="info-item">
        <text class="info-label">昵称</text>
        <text class="info-value">{{userInfo.nickname || '未设置'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">手机号</text>
        <text class="info-value">{{userInfo.phone || '未绑定'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">注册时间</text>
        <text class="info-value">{{formatDateTime(userInfo.created_at)}}</text>
      </view>
    </view>
    
    <!-- 账号安全 -->
    <view class="section">
      <view class="section-title">账号安全</view>
      <view class="setting-item" bindtap="navigateToChangePassword">
        <text class="setting-label">修改密码</text>
        <image class="setting-arrow" src="/assets/icons/arrow-right.png"></image>
      </view>
      <view class="setting-item" bindtap="bindPhone">
        <text class="setting-label">绑定手机</text>
        <text class="setting-value">{{userInfo.phone ? '已绑定' : '未绑定'}}</text>
        <image class="setting-arrow" src="/assets/icons/arrow-right.png"></image>
      </view>
    </view>
    
    <!-- 注销账号 -->
    <view class="logout-section">
      <button class="logout-btn" type="warn" bindtap="showDeleteConfirm">注销账号</button>
      <text class="logout-hint">注销后，您的所有数据将被删除，且无法恢复</text>
    </view>
  </view>
</view>