/* user.wxss */
.container {
  padding: 0;
  background-color: #f7f7f7;
  min-height: 100vh;
}

/* 用户信息卡片 */
.user-card {
  background-color: #00662c;
  padding: 40rpx 30rpx;
  display: flex;
  align-items: center;
  position: relative;
}

.user-card::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 200rpx;
  background: linear-gradient(180deg, rgba(0, 102, 44, 0) 0%, rgba(247, 247, 247, 1) 100%);
}

.user-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  overflow: hidden;
  background-color: #fff;
  margin-right: 30rpx;
  flex-shrink: 0;
}

.user-avatar image {
  width: 100%;
  height: 100%;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
  display: block;
  margin-bottom: 12rpx;
}

.user-id {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.user-action {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: 40rpx;
  background-color: rgba(255, 255, 255, 0.2);
}

.user-action text {
  font-size: 28rpx;
  color: #fff;
  margin-right: 8rpx;
}

/* 功能区块 */
.feature-section {
  margin: 20rpx 30rpx 0;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  padding: 32rpx 30rpx 16rpx;
}

/* 网格布局功能 */
.feature-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 10rpx 30rpx;
}

.feature-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  padding: 20rpx 10rpx;
  box-sizing: border-box;
}

.feature-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  background-color: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.feature-icon image {
  width: 60rpx;
  height: 60rpx;
}

.feature-name {
  font-size: 26rpx;
  color: #666;
}

.feature-count {
  position: absolute;
  top: 10rpx;
  right: 15rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 12rpx;
  background-color: #ff4d4f;
  color: #fff;
  font-size: 24rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 列表布局功能 */
.feature-list {
  padding: 0 30rpx;
}

.feature-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.feature-row:last-child {
  border-bottom: none;
}

.feature-text {
  font-size: 28rpx;
  color: #333;
}

/* 退出登录按钮 */
.logout-section {
  margin: 40rpx 30rpx 60rpx;
}

.btn-logout {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background-color: #fff;
  color: #666;
  font-size: 32rpx;
  border-radius: 48rpx;
  border: 1rpx solid #f0f0f0;
}

.btn-logout:active {
  background-color: #f5f5f5;
}